{
  "name": "minijob-admin",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "docker:build": "docker build -t nbigot/minijob-admin .",
    "docker:compose": "docker-compose up -d",
    "docker:run": "docker run --rm --name minijob-admin -e BACKEND_URL=\"http://host.docker.internal:8080\" -e PROMETHEUS_URL=\"http://host.docker.internal:9090\" -p 8081:80 nbigot/minijob-admin:latest",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "axios": "^1.20.0",
    "axios-mock-adapter": "^2.1.0",
    "chart.js": "^4.6.1",
    "vue": "3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.3.7",
    "vite": "^7.3.7",
    "vitepress": "^1.6.4",
    "vitest": "^3.1.4"
  }
}
